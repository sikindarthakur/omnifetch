PORT=3000
NODE_ENV=development
YTDLP_PATH=yt-dlp

# Optional: YouTube Cookies for bypassing bot checks / datacenter IP blocks (e.g. on Render.com)
# Option A: Paste the raw text content of your cookies.txt here:
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n..."
# Option B: Path to a cookies.txt file on the server:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
